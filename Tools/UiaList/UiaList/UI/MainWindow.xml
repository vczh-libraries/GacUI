<Instance ref.Class="uialist::MainWindow" xmlns:vm="uialist::vm::*" xmlns:app="uialist::*">
  <ref.Parameter Name="ViewModel" Class="uialist::vm::IUiaListViewModel"/>
  <ref.LocalizedStrings Name="Strings" Class="uialist::Strings" Default="true"/>
  <ref.Members><![CDATA[
    prop Dialog : uialist::vm::IPropertyDialogViewModel^ = null {}
    prop CurrentTab : int = 0 {}
    prop ProcessData : uialist::vm::IProcessNodeViewModel^ = null {}
    prop NodeData : uialist::vm::INodeViewModel^ = null {}
    prop FocusNode : uialist::vm::INodeViewModel^ = null {}
    var shownDialog : uialist::vm::IPropertyDialogViewModel^ = null;
    func SyncTree(tree : GuiBindableTreeView*, processes : bool) : void
    {
      GuiApplication::GetApplication().InvokeInMainThread(self, func() : void
      {
        var provider = tree.NodeRootProvider;
        var pending : presentation::controls::tree::INodeProvider^[] = {};
        pending.Add(provider.RootNode);
        var position = 0;
        var selected : presentation::controls::tree::INodeProvider^ = null;
        while (position < pending.Count)
        {
          var node = pending[position];
          position = position + 1;
          if (processes)
          {
            var item = provider.GetBindingValue(cast (presentation::controls::tree::INodeProvider*) node) as uialist::vm::IProcessNodeViewModel^;
            if (item is not null) { node.Expanding = item.IsExpanded; }
          }
          else
          {
            var item = provider.GetBindingValue(cast (presentation::controls::tree::INodeProvider*) node) as uialist::vm::INodeViewModel^;
            if (item is not null)
            {
              node.Expanding = item.IsExpanded or item.IsSyntheticRoot;
              if (item.IsSelected) { selected = node; }
            }
          }
          for (i in range [0, node.ChildCount)) { pending.Add(node.GetChild(i)); }
        }
        if (selected is not null)
        {
          var index = tree.NodeItemView.CalculateNodeVisibilityIndex(cast (presentation::controls::tree::INodeProvider*) selected);
          if (index >= 0)
          {
            tree.ClearSelection();
            tree.SetSelected(index, true);
            tree.EnsureItemVisible(index);
          }
        }
      });
    }
  ]]></ref.Members>
  <Window ref.Name="self" Text-str="AppTitle()" ClientSize="x:1100 y:760" Dialog-bind="ViewModel.PropertyDialog" CurrentTab-bind="ViewModel.ActiveTab" ProcessData-bind="ViewModel.ProcessRoot" NodeData-bind="ViewModel.NodeRoot" FocusNode-bind="ViewModel.SelectedNode">
    <ev.ProcessDataChanged-eval>self.SyncTree(processTree, true);</ev.ProcessDataChanged-eval>
    <ev.NodeDataChanged-eval>self.SyncTree(nodeTree, false);</ev.NodeDataChanged-eval>
    <ev.FocusNodeChanged-eval>self.SyncTree(nodeTree, false);</ev.FocusNodeChanged-eval>
    <ev.DialogChanged-eval><![CDATA[{
      GuiApplication::GetApplication().InvokeInMainThread(self, func() : void
      {
        if (self.Dialog is not null and self.Dialog.IsOpen and self.shownDialog != self.Dialog)
        {
          var dialog = self.Dialog;
          self.shownDialog = dialog;
          var window = new uialist::PropertyWindow*(dialog);
          window.ForceCalculateSizeImmediately();
          window.MoveToScreenCenter();
          window.ShowModalAndDelete(self, func() : void
          {
            dialog.Close();
            if (self.shownDialog == dialog) { self.shownDialog = null; }
            nodeTree.SetFocused();
          });
        }
      });
    }]]></ev.DialogChanged-eval>
    <ev.CurrentTabChanged-eval><![CDATA[{
      mainTabs.SelectedPage = self.CurrentTab == 1 ? previewPage : self.CurrentTab == 2 ? nodesPage : processesPage;
    }]]></ev.CurrentTabChanged-eval>
    <ev.WindowOpened-eval>ViewModel.Initialize();</ev.WindowOpened-eval>
    <ev.WindowClosing-eval>ViewModel.RequestClose();</ev.WindowClosing-eval>
