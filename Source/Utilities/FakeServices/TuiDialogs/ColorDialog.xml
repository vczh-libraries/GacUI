<Folder>
  <Instance name="TuiColorComponentControlResource">
    <Instance ref.CodeBehind="false" ref.Class="tui_controls::TuiColorComponentControl">
      <ref.Members><![CDATA[
        prop Value : int = 0 {}
        prop TextBoxAlt : string = "" {}
      ]]></ref.Members>
      <CustomControl ref.Name="self" Value-bind="tracker.Position">
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren" CellPadding="1">
          <att.Rows>
            <_>composeType:Percentage percentage:1.0</_>
          </att.Rows>
          <att.Columns>
            <_>composeType:Absolute absolute:6</_>
            <_>composeType:Percentage percentage:1.0</_>
          </att.Columns>
          <Cell Site="row:0 column:0 ">
            <SinglelineTextBox ref.Name="textBox" Text-bind="cast string self.Value" Alt-bind="self.TextBoxAlt">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
              <ev.TextChanged-eval><![CDATA[{var value = cast int textBox.Text ?? -1; tracker.Position = value < 0 ? 0 : (value > 255 ? 255 : value);}]]></ev.TextChanged-eval>
            </SinglelineTextBox>
          </Cell>
          <Cell Site="row:0 column:1 ">
            <HTracker ref.Name="tracker" TotalSize="256" PageSize="1" SmallMove="1" BigMove="16">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
            </HTracker>
          </Cell>
        </Table>
      </CustomControl>
    </Instance>
  </Instance>
  <Instance name="TuiColorDialogControlResource">
    <Instance ref.CodeBehind="false" ref.Class="tui_controls::TuiColorDialogControl" xmlns:g="tui_controls::*">
      <ref.LocalizedStrings Name="Strings" Class="tui_controls::TuiDialogStrings" Default="true" />
      <ref.Parameter Name="ViewModel" Class="presentation::IColorDialogViewModel" />
      <ref.Members><![CDATA[
        prop Value : Color = cast Color "#FFFFFF" {}

        func ReadColor() : Color
        {
          return {
            r: (cast UInt8 colorRed.Value)
            g: (cast UInt8 colorGreen.Value)
            b: (cast UInt8 colorBlue.Value)
          };
        }
      ]]></ref.Members>
      <CustomControl ref.Name="self" Value-bind="self.observe as c(c.ReadColor() on c.colorRed.ValueChanged, c.colorGreen.ValueChanged, c.colorBlue.ValueChanged)">
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren" CellPadding="0">
          <att.Rows>
            <_>composeType:MinSize</_>
            <_>composeType:MinSize</_>
            <_>composeType:MinSize</_>
            <_>composeType:Percentage percentage:1.0</_>
          </att.Rows>
          <att.Columns>
            <_>composeType:MinSize</_>
            <_>composeType:Percentage percentage:1.0</_>
          </att.Columns>
          <Cell Site="row:0 column:0 ">
            <Label Text-str="Red()" />
          </Cell>
          <Cell Site="row:1 column:0 ">
            <Label Text-str="Green()" />
          </Cell>
          <Cell Site="row:2 column:0 ">
            <Label Text-str="Blue()" />
          </Cell>
          <Cell Site="row:3 column:0 ">
            <Label Text-str="Color()" />
          </Cell>
          <Cell Site="row:0 column:1 ">
            <g:TuiColorComponentControl ref.Name="colorRed" Value-eval="cast int ViewModel.Color.r" TextBoxAlt="R">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
            </g:TuiColorComponentControl>
          </Cell>
          <Cell Site="row:1 column:1 ">
            <g:TuiColorComponentControl ref.Name="colorGreen" Value-eval="cast int ViewModel.Color.g" TextBoxAlt="G">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
            </g:TuiColorComponentControl>
          </Cell>
          <Cell Site="row:2 column:1 ">
            <g:TuiColorComponentControl ref.Name="colorBlue" Value-eval="cast int ViewModel.Color.b" TextBoxAlt="B">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
            </g:TuiColorComponentControl>
          </Cell>
          <Cell Site="row:3 column:1 ">
            <SolidBackground Color-bind="self.Value" />
            <Bounds AlignmentToParent="left:1 top:0 right:1 bottom:0">
              <SolidLabel Text-bind="cast string self.Value" Color-bind="{r:(cast UInt8 (255 - cast int self.Value.r)) g:(cast UInt8 (255 - cast int self.Value.g)) b:(cast UInt8 (255 - cast int self.Value.b))}" />
            </Bounds>
          </Cell>
        </Table>
      </CustomControl>
    </Instance>
  </Instance>
  <Instance name="TuiColorDialogWindowResource">
    <Instance ref.CodeBehind="false" ref.Class="tui_controls::TuiColorDialogWindow" xmlns:g="tui_controls::*">
      <ref.LocalizedStrings Name="Strings" Class="tui_controls::TuiDialogStrings" Default="true" />
      <ref.Parameter Name="ViewModel" Class="presentation::IColorDialogViewModel" />
      <Window ref.Name="self" ClientSize="x:52 y:15" ShowInTaskBar="false" MaximizedBox="false" MinimizedBox="false" IconVisible="false" Text-str="ColorDialogTitle()">
        <Table AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren" CellPadding="1">
          <att.Rows>
            <_>composeType:Percentage percentage:1.0</_>
            <_>composeType:MinSize</_>
          </att.Rows>
          <att.Columns>
            <_>composeType:Percentage percentage:1.0</_>
            <_>composeType:MinSize</_>
            <_>composeType:MinSize</_>
          </att.Columns>
          <Cell Site="row:0 column:0 columnSpan:3">
            <g:TuiColorDialogControl ref.Name="colorControl" ViewModel-eval="ViewModel">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
            </g:TuiColorDialogControl>
          </Cell>
          <Cell Site="row:1 column:1 ">
            <Button Text-str="OK()" Alt="O">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
              <ev.Clicked-eval><![CDATA[{ViewModel.Confirmed = true; ViewModel.Color = colorControl.Value; self.Close();}]]></ev.Clicked-eval>
            </Button>
          </Cell>
          <Cell Site="row:1 column:2 ">
            <Button Text-str="Cancel()" Alt="C">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
              <ev.Clicked-eval><![CDATA[{self.Close();}]]></ev.Clicked-eval>
            </Button>
          </Cell>
        </Table>
      </Window>
    </Instance>
  </Instance>
</Folder>