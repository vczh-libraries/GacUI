<Folder>
  <Instance name="LabelTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="tuiskin::TuiLabelTemplate" xmlns:x="tuiskin::*" ref.Styles="res://TuiSkin/Style">
      <LabelTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" DefaultTextColor-eval="tuiskin::tuiColors.LabelText">
        <SolidLabel Text-bind="self.Text" Font-bind="self.Font" Color-bind="self.VisuallyEnabled ? self.TextColor : tuiskin::tuiColors.ControlBorderDisabled" Multiline="true" />
      </LabelTemplate>
    </Instance>
  </Instance>
  <Instance name="ShortcutKeyTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="tuiskin::TuiShortcutKeyTemplate" xmlns:x="tuiskin::*" ref.Styles="res://TuiSkin/Style">
      <LabelTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" DefaultTextColor-eval="tuiskin::tuiColors.ShortcutKeyText">
        <SolidBackground Color-eval="tuiskin::tuiColors.ShortcutKeyBackground" />
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <SolidLabel Text-bind="self.Text" Font-bind="self.Font" Color-bind="self.TextColor" />
        </Bounds>
      </LabelTemplate>
    </Instance>
  </Instance>
  <Instance name="GroupBoxTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="tuiskin::TuiGroupBoxTemplate" xmlns:x="tuiskin::*" ref.Styles="res://TuiSkin/Style">
      <ControlTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" ContainerComposition-ref="container">
        <TuiBorder Color-eval="tuiskin::tuiColors.LabelText" Shape="shapeType:RoundRect" />
        <Bounds ref.Name="container" AlignmentToParent="left:1 top:1 right:1 bottom:1" />
        <Bounds AlignmentToParent="left:2 top:0 right:-1 bottom:-1">
          <SolidBackground ref.Style="background" />
          <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
            <SolidLabel Text-bind="self.Text" Font-bind="self.Font" Color-eval="tuiskin::tuiColors.LabelText" />
          </Bounds>
        </Bounds>
      </ControlTemplate>
    </Instance>
  </Instance>
  <Instance name="DateButtonTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="tuiskin::TuiDateButtonTemplate" xmlns:x="tuiskin::*" ref.Styles="res://TuiSkin/Style">
      <SelectableButtonTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" ContainerComposition-ref="container">
        <SolidBackground ref.Style="itemBackground" />
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0" />
      </SelectableButtonTemplate>
    </Instance>
  </Instance>
  <Instance name="DatePickerTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="tuiskin::TuiDatePickerTemplate" xmlns:x="tuiskin::*" ref.Styles="res://TuiSkin/Style">
      <DatePickerTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" Date-bind="look.Date">
        <CommonDatePickerLook ref.Name="look" AlignmentToParent="left:0 top:0 right:0 bottom:0" Font-bind="self.Font" Date-bind="self.Date" DateLocale-bind="self.DateLocale" Commands-bind="self.Commands" BackgroundColor-eval="tuiskin::tuiColors.ControlBackground" PrimaryTextColor-eval="tuiskin::tuiColors.ControlText" SecondaryTextColor-eval="tuiskin::tuiColors.LabelText">
          <att.DateButtonTemplate>tuiskin::TuiDateButtonTemplate</att.DateButtonTemplate>
          <att.DateTextListTemplate>tuiskin::TuiTextListTemplate</att.DateTextListTemplate>
          <att.DateComboBoxTemplate>tuiskin::TuiComboBoxTemplate</att.DateComboBoxTemplate>
        </CommonDatePickerLook>
      </DatePickerTemplate>
    </Instance>
  </Instance>
</Folder>
