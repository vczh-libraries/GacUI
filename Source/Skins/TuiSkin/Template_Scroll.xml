  <Instance name="ProgressBarTemplateResource">
    <Instance xmlns:elements="presentation::elements::*Element" ref.CodeBehind="false" ref.Class="tuiskin::TuiProgressBarTemplate" xmlns:x="tuiskin::*" ref.Styles="res://TuiSkin/Style">
      <ScrollTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" ContainerComposition-ref="container" PreferredMinSize="y:1">
        <SolidBackground Color-eval="tuiskin::tuiColors.ControlBorderDisabled" />
        <Bounds ref.Name="container" AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <PartialView WidthPageSize-bind="self.TotalSize == self.PageSize ? 1.0 : (cast double self.Position) / (self.TotalSize - self.PageSize)">
            <SolidBackground Color-eval="tuiskin::tuiColors.ControlBorderFocused" />
          </PartialView>
        </Bounds>
      </ScrollTemplate>
    </Instance>
  </Instance>
  <Instance name="ScrollViewTemplateResource">
    <Instance xmlns:elements="presentation::elements::*Element" ref.CodeBehind="false" ref.Class="tuiskin::TuiScrollViewTemplate" xmlns:x="tuiskin::*" ref.Styles="res://TuiSkin/Style">
      <ScrollViewTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <att.ContainerComposition-eval>look.ContainerComposition</att.ContainerComposition-eval>
        <att.HorizontalScroll-eval>look.HScroll</att.HorizontalScroll-eval>
        <att.VerticalScroll-eval>look.VScroll</att.VerticalScroll-eval>
        <SolidBackground ref.Style="background" />
        <Bounds AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <elements:TuiBorder ref.Style="border" />
          <CommonScrollViewLook ref.Name="look" AlignmentToParent="left:1 top:1 right:1 bottom:1">
            <att.HScrollTemplate>tuiskin::TuiHScrollTemplate</att.HScrollTemplate>
            <att.VScrollTemplate>tuiskin::TuiVScrollTemplate</att.VScrollTemplate>
            <att.DefaultScrollSize>1</att.DefaultScrollSize>
          </CommonScrollViewLook>
        </Bounds>
      </ScrollViewTemplate>
    </Instance>
  </Instance>
