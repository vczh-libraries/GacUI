  <Instance name="HScrollTemplateResource">
    <Instance xmlns:elements="presentation::elements::*Element" ref.CodeBehind="false" ref.Class="tuiskin::TuiHScrollTemplate" xmlns:x="tuiskin::*" ref.Styles="res://TuiSkin/Style">
      <ref.Ctor><![CDATA[{
        behavior.AttachScrollTemplate(self);
        behavior.AttachDecreaseButton(buttonDecrease);
        behavior.AttachIncreaseButton(buttonIncrease);
        behavior.AttachHorizontalScrollHandle(handle);
      }]]></ref.Ctor>
      <ScrollTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren" PreferredMinSize="y:1">
        <CommonScrollBehavior ref.Name="behavior" />
        <SolidBackground Color-eval="tuiskin::tuiColors.ControlBorderDisabled" />
        <SideAligned MaxLength="1" MaxRatio="0.5" Direction="Left">
          <Button ref.Name="buttonDecrease" AutoFocus="false" ControlTemplate="tuiskin::TuiLeftScrollButtonTemplate">
            <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
          </Button>
        </SideAligned>
        <SideAligned MaxLength="1" MaxRatio="0.5" Direction="Right">
          <Button ref.Name="buttonIncrease" AutoFocus="false" ControlTemplate="tuiskin::TuiRightScrollButtonTemplate">
            <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
          </Button>
        </SideAligned>
        <Bounds AlignmentToParent="left:1 top:0 right:1 bottom:0" MinSizeLimitation="NoLimit">
          <PartialView ref.Name="handle" PreferredMinSize="x:1">
            <att.WidthPageSize-bind>(cast double self.PageSize) / self.TotalSize</att.WidthPageSize-bind>
            <att.WidthRatio-bind>(cast double self.Position) / self.TotalSize</att.WidthRatio-bind>
            <Button AutoFocus="false" ControlTemplate="tuiskin::TuiHandleScrollButtonTemplate">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
            </Button>
          </PartialView>
        </Bounds>
      </ScrollTemplate>
    </Instance>
  </Instance>
  <Instance name="HTrackerTemplateResource">
