<Resource>
  <Folder name="GacGenConfig">
    <Folder name="Cpp">
      <Text name="SourceFolder">Source</Text>
      <Text name="Resource">..\..\..\UIRes\RemoteProtocolTest.bin</Text>
      <Text name="NormalInclude">GacUI.h</Text>
      <Text name="Name">RemoteProtocolTest</Text>
    </Folder>
  </Folder>
  <Folder name="ToolbarImages" content="Link">ToolbarImages/Images.xml</Folder>
  <Folder name="SideDocuments" content="Link">SideDocuments.xml</Folder>

  <Instance name="ClickMeTabResource">
    <Instance ref.Class="rptest::ClickMeTab">
      <ref.Members><![CDATA[
        func MouseButtonName(button: NativeMouseButton): string
        {
	          if (button == NativeMouseButton::Left) { return "Left"; }
	          if (button == NativeMouseButton::Middle) { return "Middle"; }
	          if (button == NativeMouseButton::Right) { return "Right"; }
	          if (button == NativeMouseButton::Mouse4) { return "Mouse4"; }
          return "Mouse5";
        }
      ]]></ref.Members>
      <TabPage ref.Name="self" Text="Home">
        <MessageDialog ref.Name="dialogLocalShortcut" Title="Remote Protocol Test" Text="You pressed Ctrl+Q!"/>
        <MessageDialog ref.Name="dialogLocalSuperShortcut" Title="Remote Protocol Test" Text="You pressed Ctrl+Win+Q!"/>
        <MessageDialog ref.Name="dialogGlobalShortcut" Title="Remote Protocol Test" Text="You pressed Ctrl+Shift+Alt+Win+Q!"/>
        <ToolstripCommand ref.Name="commandLocalShortcut" ShortcutBuilder="Ctrl+Q">
          <ev.Executed-eval><![CDATA[{
            dialogLocalShortcut.ShowDialog();
          }]]></ev.Executed-eval>
        </ToolstripCommand>
        <ToolstripCommand ref.Name="commandLocalSuperShortcut" ShortcutBuilder="Ctrl+Win+Q">
          <ev.Executed-eval><![CDATA[{
            dialogLocalSuperShortcut.ShowDialog();
          }]]></ev.Executed-eval>
        </ToolstripCommand>
        <ToolstripCommand ref.Name="commandGlobalShortcut" ShortcutBuilder="global:Ctrl+Shift+Alt+Command+Q">
          <ev.Executed-eval><![CDATA[{
            dialogGlobalShortcut.ShowDialog();
          }]]></ev.Executed-eval>
        </ToolstripCommand>
        <Table CellPadding="10" AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren">
          <att.Rows>
            <_>composeType:MinSize</_>
            <_>composeType:MinSize</_>
            <_>composeType:MinSize</_>
            <_>composeType:MinSize</_>
            <_>composeType:MinSize</_>
            <_>composeType:Percentage percentage:1.0</_>
          </att.Rows>
          <att.Columns>
            <_>composeType:MinSize</_>
            <_>composeType:MinSize</_>
            <_>composeType:Percentage percentage:1.0</_>
          </att.Columns>

          <Cell Site="row:0 column:0">
            <Button ref.Name="buttonClickMe" Alt="X" Text="Click Me!">
              <ev.Clicked-eval><![CDATA[{
                buttonClickMe.Text = "You have clicked!";
              }]]></ev.Clicked-eval>
            </Button>
          </Cell>
          <Cell Site="row:0 column:1">
            <Button Alt="Y" Text="Fatel Error">
              <ev.Clicked-eval><![CDATA[{
                raise "This is a fatel error!";
              }]]></ev.Clicked-eval>
            </Button>
          </Cell>
          <Cell Site="row:1 column:0 columnSpan:3">
            <Label Text-bind="commandLocalShortcut.Shortcut.Name"/>
          </Cell>
          <Cell Site="row:2 column:0 columnSpan:3">
            <Label Text-bind="commandLocalSuperShortcut.Shortcut.Name"/>
          </Cell>
          <Cell Site="row:3 column:0 columnSpan:3">
            <Label Text-bind="commandGlobalShortcut.Shortcut.Name"/>
          </Cell>
          <Cell Site="row:4 column:0 columnSpan:3">
            <Bounds PreferredMinSize="y:24" AlignmentToParent="left:0 top:0 right:0 bottom:0">
              <SolidLabel ref.Name="labelMouseButton" Text="Click here with any mouse button." VerticalAlignment="Center"/>
              <ev.mouseDown-eval><![CDATA[{
	                labelMouseButton.Text = self.MouseButtonName(arguments.button) & " button down!";
              }]]></ev.mouseDown-eval>
              <ev.mouseUp-eval><![CDATA[{
	                labelMouseButton.Text = self.MouseButtonName(arguments.button) & " button up!";
              }]]></ev.mouseUp-eval>
            </Bounds>
          </Cell>
          <Cell Site="row:5 column:0 columnSpan:3">
            <Raw/>
          </Cell>
        </Table>
      </TabPage>
    </Instance>
  </Instance>

  <Script name="ViewModelResource">
    <Workflow>
      <![CDATA[
        module viewmodel;
        
        using system::*;
        using presentation::*;
        
        namespace rptest
        {
          class DataItem
          {
            prop Name : string = "" {not observe}
            prop Title : string = "" {not observe}
            prop Description : string = "" {not observe}

            new(name:string, title:string, description:string)
            {
              Name = name;
              Title = title;
              Description = description;
            }
          }
        }
      ]]>
    </Workflow>
  </Script>

  <Instance name="DataGridTabResource">
    <Instance ref.Class="rptest::DataGridTab">
      <ref.Members><![CDATA[
        var itemSource : observe DataItem^[] = {};
      ]]></ref.Members>
      <TabPage ref.Name="self" Text="DataGrid">
        <Table CellPadding="10" AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren">
          <att.Rows>
            <_>composeType:MinSize</_>
            <_>composeType:Percentage percentage:1.0</_>
          </att.Rows>
          <att.Columns>
            <_>composeType:MinSize</_>
            <_>composeType:MinSize</_>
            <_>composeType:Percentage percentage:1.0</_>
          </att.Columns>

          <Cell Site="row:0 column:0">
            <Button Alt="X" Text="Add 3 Rows">
              <ev.Clicked-eval><![CDATA[{
                for (i in range [1, 3])
                {
                  self.itemSource.Add(new DataItem^(
                    Sys::LoremIpsumTitle(12),
                    Sys::LoremIpsumTitle(20),
                    Sys::LoremIpsumSentence(40)
                  ));
                }
              }]]></ev.Clicked-eval>
            </Button>
          </Cell>
          <Cell Site="row:0 column:1">
            <Button Alt="Y" Text="Clear">
              <ev.Clicked-eval><![CDATA[{
                self.itemSource.Clear();
              }]]></ev.Clicked-eval>
            </Button>
          </Cell>
          <Cell Site="row:1 column:0 columnSpan:3">
            <BindableDataGrid Alt="Z" env.ItemType="rptest::DataItem^" VerticalAlwaysVisible="false" HorizontalAlwaysVisible="false">
              <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
              <att.ItemSource-eval>self.itemSource</att.ItemSource-eval>
              <att.Columns>
                <DataColumn Text="Name" Size="120">
                  <att.TextProperty>Name</att.TextProperty>
                </DataColumn>
                <DataColumn Text="Title" Size="160">
                  <att.TextProperty>Title</att.TextProperty>
                </DataColumn>
                <DataColumn Text="Description" Size="300">
                  <att.TextProperty>Description</att.TextProperty>
                </DataColumn>
              </att.Columns>
            </BindableDataGrid>
          </Cell>
        </Table>
      </TabPage>
    </Instance>
  </Instance>

