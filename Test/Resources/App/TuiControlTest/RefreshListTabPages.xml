                <Button Text="*First">
                  <ev.Clicked-eval><![CDATA[
                {
                  var node = treeView.Nodes.RootNode.GetChild(0);
                  var data = treeView.Nodes.GetTreeViewData(cast * node);
                  data.text = data.text == "First" ? "One" : "First";
                  treeView.Nodes.UpdateTreeViewData(cast * node);
