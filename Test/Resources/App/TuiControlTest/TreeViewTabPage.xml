<Instance ref.CodeBehind="false" ref.Class="tuidemo::TuiTreeViewTabPage">
  <ref.Members><![CDATA[
      var nodesToBind : MemoryNodeProvider^ = null;
    ]]></ref.Members>
  <ref.Ctor><![CDATA[
      bindableTreeView.ItemSource = nodesToBind;
    ]]></ref.Ctor>
  <TabPage ref.Name="self" Text="TreeView">
    <Table AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren" CellPadding="0">
      <att.Rows>
        <_>composeType:MinSize</_>
        <_>composeType:Percentage percentage:1.0</_>
      </att.Rows>
      <att.Columns>
        <_>composeType:Percentage percentage:1.0</_>
        <_>composeType:Percentage percentage:1.0</_>
      </att.Columns>
      <Cell Site="row:0 column:0 columnSpan:2">
        <Stack Direction="Horizontal" Padding="1" AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren">
          <StackItem>
            <Button Alt="X" Text="Rotate Item Source --&gt;">
              <att.BoundsComposition-set />
              <ev.Clicked-eval><![CDATA[
              {
                if (bindableTreeView.ItemSource is not null)
                {
                  bindableTreeView.ItemSource = null;
                }
                else
                {
                  bindableTreeView.ItemSource = self.nodesToBind;
                }
              }
            ]]></ev.Clicked-eval>
            </Button>
          </StackItem>
          <StackItem>
            <Label Text="▶ Expand / ▼ Collapse — Left and Right trees keep independent state." />
          </StackItem>
        </Stack>
      </Cell>
      <Cell Site="row:1 column:0 ">
        <TreeView ref.Name="treeView" Alt="L" HorizontalAlwaysVisible="false" VerticalAlwaysVisible="false">
          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
          <att.Nodes>
            <TreeNode Text="Blue+">
              <TreeNode Text="&lt;--" />
              <TreeNode Text="--&gt;" />
              <TreeNode Text="V" />
              <TreeNode Text="^" />
              <TreeNode Text="&lt;" />
              <TreeNode Text="&gt;" />
            </TreeNode>
            <TreeNode Text="Green+">
              <TreeNode Text="V" />
              <TreeNode Text="^" />
              <TreeNode Text="&lt;" />
              <TreeNode Text="&gt;" />
            </TreeNode>
            <TreeNode Text="Grey+">
              <TreeNode Text="V" />
              <TreeNode Text="^" />
              <TreeNode Text="&lt;" />
              <TreeNode Text="&gt;" />
            </TreeNode>
            <TreeNode Text="Orange+">
              <TreeNode Text="V" />
              <TreeNode Text="^" />
              <TreeNode Text="&lt;" />
              <TreeNode Text="&gt;" />
            </TreeNode>
          </att.Nodes>
        </TreeView>
      </Cell>
      <Cell Site="row:1 column:1 ">
        <BindableTreeView ref.Name="bindableTreeView" Alt="L" env.ItemType="MemoryNodeProvider^" env.ItemName="nodeToBind" HorizontalAlwaysVisible="false" VerticalAlwaysVisible="false">
          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
          <att.TextProperty>(nodeToBind.Data as TreeViewItem^).text</att.TextProperty>
          <att.ChildrenProperty>Children</att.ChildrenProperty>
        </BindableTreeView>
      </Cell>
    </Table>
    <att.nodesToBind>
      <TreeNode>
        <TreeNode Text="Blue+">
          <TreeNode Text="&lt;--" />
          <TreeNode Text="--&gt;" />
          <TreeNode Text="V" />
          <TreeNode Text="^" />
          <TreeNode Text="&lt;" />
          <TreeNode Text="&gt;" />
        </TreeNode>
        <TreeNode Text="Green+">
          <TreeNode Text="V" />
          <TreeNode Text="^" />
          <TreeNode Text="&lt;" />
          <TreeNode Text="&gt;" />
        </TreeNode>
        <TreeNode Text="Grey+">
          <TreeNode Text="V" />
          <TreeNode Text="^" />
          <TreeNode Text="&lt;" />
          <TreeNode Text="&gt;" />
        </TreeNode>
        <TreeNode Text="Orange+">
          <TreeNode Text="V" />
          <TreeNode Text="^" />
          <TreeNode Text="&lt;" />
          <TreeNode Text="&gt;" />
        </TreeNode>
      </TreeNode>
    </att.nodesToBind>
  </TabPage>
</Instance>