<Resource>
  <Folder name="GacGenConfig">
    <Folder name="Cpp">
      <Text name="SourceFolder">Source</Text>
      <Text name="NormalInclude">GacUI.h</Text>
      <Text name="Name">TuiControlTest</Text>
    </Folder>
  </Folder>
  <InstanceStyle name="WindowManagerContentStyles">
    <Styles>
      <Style ref.Path="//Window" ControlThemeName="CustomFrameWindow" MaximizedBox-bind="checkMax.Selected" MinimizedBox-bind="checkMin.Selected" Border-bind="checkBorder.Selected" SizeBox-bind="checkSizeBox.Selected" IconVisible-bind="checkIcon.Selected" TitleBar-bind="checkTitle.Selected" />
      <Style ref.Path="//*.windowManagerContent" Direction="Vertical" AlignmentToParent="left:0 top:0 right:0 bottom:0" Padding="0" MinSizeLimitation="LimitToElementAndChildren">
        <StackItem>
          <CheckBox ref.Name="checkFrame" Text="Customized Frame" Selected-eval="self.ControlThemeName == ThemeName::CustomFrameWindow" Enabled-bind="self.FrameConfig.CustomFrameEnabled == BoolOption::Customizable">
            <ev.SelectedChanged-eval><![CDATA[
              {
                if (checkFrame.Selected)
                {
                  self.ControlThemeName = CustomFrameWindow;
                }
                else
                {
                  self.ControlThemeName = SystemFrameWindow;
                }
              }
            ]]></ev.SelectedChanged-eval>
          </CheckBox>
        </StackItem>
        <StackItem>
          <CheckBox ref.Name="checkMax" Text="MaximizedBox" Selected-eval="self.MaximizedBox" Enabled-bind="self.FrameConfig.MaximizedBoxOption == BoolOption::Customizable" />
        </StackItem>
        <StackItem>
          <CheckBox ref.Name="checkMin" Text="MinimizedBox" Selected-eval="self.MinimizedBox" Enabled-bind="self.FrameConfig.MinimizedBoxOption == BoolOption::Customizable" />
        </StackItem>
        <StackItem>
          <CheckBox ref.Name="checkBorder" Text="Border" Selected-eval="self.Border" Enabled-bind="self.FrameConfig.BorderOption == BoolOption::Customizable" />
        </StackItem>
        <StackItem>
          <CheckBox ref.Name="checkSizeBox" Text="SizeBox" Selected-eval="self.SizeBox" Enabled-bind="self.FrameConfig.SizeBoxOption == BoolOption::Customizable" />
        </StackItem>
        <StackItem>
          <CheckBox ref.Name="checkIcon" Text="IconVisible" Selected-eval="self.IconVisible" Enabled-bind="self.FrameConfig.IconVisibleOption == BoolOption::Customizable" />
        </StackItem>
        <StackItem>
          <CheckBox ref.Name="checkTitle" Text="TitleBar" Selected-eval="self.TitleBar" Enabled-bind="self.FrameConfig.TitleBarOption == BoolOption::Customizable" />
        </StackItem>
        <StackItem>
          <Button Text="Open New Window">
            <ev.Clicked-eval><![CDATA[
              {
                var subWindow = new TuiSubWindow*();
                self.openedSubWindows.Add(cast (TuiSubWindow^) subWindow);
                subWindow.MoveToScreenCenter();
                subWindow.ShowWithOwner(self);
              }
            ]]></ev.Clicked-eval>
          </Button>
        </StackItem>
      </Style>
    </Styles>
  </InstanceStyle>
  <Instance name="SubWindowResource">
    <Instance ref.CodeBehind="false" ref.Class="tuidemo::TuiSubWindow" ref.Styles="res://WindowManagerContentStyles">
      <ref.Members><![CDATA[
        var openedSubWindows: GuiWindow^[] = {};
      ]]></ref.Members>
      <Window ref.Name="self" Text-eval="Sys::LoremIpsumTitle(20)" ClientSize="x:48 y:22">
        <Stack ref.Style="windowManagerContent" />
      </Window>
    </Instance>
  </Instance>
  <Instance name="MainWindowResource">
    <Instance ref.CodeBehind="false" ref.Class="tuidemo::TuiMainWindow" xmlns:demo="tuidemo::*" xmlns:x="presentation::controls::GuiSelectableButton::*" ref.Styles="res://WindowManagerContentStyles">
      <ref.Members><![CDATA[
        var openedSubWindows: GuiWindow^[] = {};
        prop invocationCount : int = 0 {}
        prop closingCount : int = 0 {}
        prop readyToCloseCount : int = 0 {}

        event PaletteSelected(int);

        func ShowMouseModifiers(alt: bool, osSuper: bool): void
        {
          var altText = "0";
          var superText = "0";
          if (alt) { altText = "1"; }
          if (osSuper) { superText = "1"; }
          labelMouseModifiers.Text = "Alt: " & altText & "; Super: " & superText;
        }

        func MouseButtonName(button: NativeMouseButton): string
        {
	          if (button == NativeMouseButton::Left) { return "Left"; }
	          if (button == NativeMouseButton::Middle) { return "Middle"; }
	          if (button == NativeMouseButton::Right) { return "Right"; }
	          if (button == NativeMouseButton::Mouse4) { return "Mouse4"; }
          return "Mouse5";
        }
      ]]></ref.Members>
      <Window ref.Name="self" ControlThemeName="SystemFrameWindow" Text="Complete Control Showcase (TUI)" ClientSize="x:120 y:40">
        <ev.WindowClosing-eval><![CDATA[{
          self.closingCount = self.closingCount + 1;
          arguments.cancel = checkCancelClose.Selected;
        }]]></ev.WindowClosing-eval>
        <ev.WindowReadyToClose-eval><![CDATA[{
          self.readyToCloseCount = self.readyToCloseCount + 1;
        }]]></ev.WindowReadyToClose-eval>
        <MessageDialog ref.Name="dialogLocalShortcut" Title-eval="self.Text" Text="You pressed Ctrl+Q!" />
        <MessageDialog ref.Name="dialogLocalSuperShortcut" Title-eval="self.Text" Text="You pressed Ctrl+Alt+Win+Q!" />
        <MessageDialog ref.Name="dialogGlobalShortcut" Title-eval="self.Text" Text="You pressed Ctrl+Shift+Alt+Win+F8!" />
        <ToolstripCommand ref.Name="commandLocalShortcut" ShortcutBuilder="Ctrl+Q">
          <ev.Executed-eval><![CDATA[{
            dialogLocalShortcut.ShowDialog();
          }]]></ev.Executed-eval>
        </ToolstripCommand>
        <ToolstripCommand ref.Name="commandLocalSuperShortcut" ShortcutBuilder="Ctrl+Alt+Win+Q">
          <ev.Executed-eval><![CDATA[{
            dialogLocalSuperShortcut.ShowDialog();
          }]]></ev.Executed-eval>
        </ToolstripCommand>
        <ToolstripCommand ref.Name="commandGlobalShortcut" ShortcutBuilder="global:Ctrl+Shift+Alt+Command+F8">
          <ev.Executed-eval><![CDATA[{
            dialogGlobalShortcut.ShowDialog();
          }]]></ev.Executed-eval>
        </ToolstripCommand>
        <att.BoundsComposition-set PreferredMinSize="x:80 y:25" MinSizeLimitation="NoLimit" />
        <Tab>
          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
          <att.Pages>
            <TabPage Alt="L" Text="List">
              <Tab>
                <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
                <att.Pages>
                  <demo:TuiTextListTabPage Alt="T" />
                  <demo:TuiListViewTabPage Alt="L" />
                  <demo:TuiTreeViewTabPage Alt="T" />
                  <demo:TuiDataGridTabPage Alt="D" />
                </att.Pages>
              </Tab>
            </TabPage>
            <TabPage Alt="L" Text="Refresh List">
              <Tab>
                <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
                <att.Pages>
                  <demo:TuiRefreshTextListTabPage Alt="T" />
                  <demo:TuiRefreshBindableTextListTabPage Alt="BT" />
                  <demo:TuiRefreshListViewTabPage Alt="L" />
                  <demo:TuiRefreshBindableListViewTabPage Alt="BL" />
                  <demo:TuiRefreshTreeViewTabPage Alt="T" />
                  <demo:TuiRefreshBindableTreeViewTabPage Alt="BT" />
                  <demo:TuiRefreshBindableDataGridTabPage Alt="D" />
                </att.Pages>
              </Tab>
            </TabPage>
            <TabPage Alt="L" Text="Layout">
              <Tab>
                <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
                <att.Pages>
                  <demo:TuiRepeatTabPage Alt="R" />
                  <demo:TuiResponsiveTabPage Alt="R" />
                </att.Pages>
              </Tab>
            </TabPage>
            <TabPage Alt="L" Text="Control">
              <Tab>
                <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
                <att.Pages>
                  <TabPage Alt="D" Text-bind="editorToolstrip.Text">
                    <demo:TuiDocumentEditorToolstrip ref.Name="editorToolstrip">
                      <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
                    </demo:TuiDocumentEditorToolstrip>
                  </TabPage>
                  <demo:TuiTextBoxTabPage Alt="T" />
                  <demo:TuiEmbeddedControlsSubTabPage Alt="E" />
                </att.Pages>
              </Tab>
            </TabPage>
            <TabPage Alt="M" Text="Misc">
              <Tab>
                <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0" />
                <att.Pages>
                  <demo:TuiLocalizedStringsTabPage Alt="L" />
                  <demo:TuiLocalizedDialogsTabPage Alt="L" />
                  <demo:TuiDatePickerTabPage Alt="D" />
                </att.Pages>
              </Tab>
            </TabPage>
            <TabPage Alt="W" Text="Window Manager">
              <x:MutexGroupController ref.Name="paletteGroup" />
              <Table AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren" CellPadding="0">
                <att.Rows>
                  <_>composeType:Percentage percentage:1.0</_>
                </att.Rows>
                <att.Columns>
                  <_>composeType:Percentage percentage:1.0</_>
                  <_>composeType:Percentage percentage:1.0</_>
                </att.Columns>
                <Cell Site="row:0 column:0">
                  <Stack ref.Style="windowManagerContent">
                    <StackItem>
                      <Label Text-bind="commandLocalShortcut.Shortcut.Name" />
                    </StackItem>
                    <StackItem>
                      <Label Text-bind="commandLocalSuperShortcut.Shortcut.Name" />
                    </StackItem>
                    <StackItem>
                      <Label Text-bind="commandGlobalShortcut.Shortcut.Name" />
                    </StackItem>
                    <StackItem>
                      <Label ref.Name="labelMouseButton" Text="Click here with any mouse button.">
                        <att.BoundsComposition-set PreferredMinSize="y:1" AlignmentToParent="left:0 top:0 right:0 bottom:0">
                          <ev.mouseDown-eval><![CDATA[{
                            labelMouseButton.Text = self.MouseButtonName(arguments.button) & " button down!";
                      self.ShowMouseModifiers(arguments.alt, arguments.osSuper);
                          }]]></ev.mouseDown-eval>
                          <ev.mouseUp-eval><![CDATA[{
                            labelMouseButton.Text = self.MouseButtonName(arguments.button) & " button up!";
                      self.ShowMouseModifiers(arguments.alt, arguments.osSuper);
                          }]]></ev.mouseUp-eval>
                          <ev.mouseMove-eval><![CDATA[{
                      self.ShowMouseModifiers(arguments.alt, arguments.osSuper);
                    }]]></ev.mouseMove-eval>
                          <ev.mouseDoubleClick-eval><![CDATA[{
                      self.ShowMouseModifiers(arguments.alt, arguments.osSuper);
                    }]]></ev.mouseDoubleClick-eval>
                          <ev.verticalWheel-eval><![CDATA[{
                      self.ShowMouseModifiers(arguments.alt, arguments.osSuper);
                    }]]></ev.verticalWheel-eval>
                          <ev.horizontalWheel-eval><![CDATA[{
                      self.ShowMouseModifiers(arguments.alt, arguments.osSuper);
                    }]]></ev.horizontalWheel-eval>
                        </att.BoundsComposition-set>
                      </Label>
                    </StackItem>
                    <StackItem>
                      <Label ref.Name="labelMouseModifiers" Text="Alt: 0; Super: 0" />
                    </StackItem>
                  </Stack>
                </Cell>
                <Cell Site="row:0 column:1">
                  <GroupBox Text="Color Theme">
                    <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:-1" />
                    <Stack Direction="Vertical" Padding="0" AlignmentToParent="left:0 top:0 right:0 bottom:0" MinSizeLimitation="LimitToElementAndChildren">
                      <StackItem>
                        <RadioButton ref.Name="palettePink" Text="Pink" GroupController-ref="paletteGroup">
                          <ev.SelectedChanged-eval><![CDATA[{if (palettePink.Selected) {self.PaletteSelected(0);}}]]></ev.SelectedChanged-eval>
                        </RadioButton>
                      </StackItem>
                      <StackItem>
                        <RadioButton ref.Name="paletteOrange" Text="Orange" GroupController-ref="paletteGroup">
                          <ev.SelectedChanged-eval><![CDATA[{if (paletteOrange.Selected) {self.PaletteSelected(1);}}]]></ev.SelectedChanged-eval>
                        </RadioButton>
                      </StackItem>
                      <StackItem>
                        <RadioButton ref.Name="paletteGrass" Text="Grass" GroupController-ref="paletteGroup">
                          <ev.SelectedChanged-eval><![CDATA[{if (paletteGrass.Selected) {self.PaletteSelected(2);}}]]></ev.SelectedChanged-eval>
                        </RadioButton>
                      </StackItem>
                      <StackItem>
                        <RadioButton ref.Name="paletteEmerald" Text="Emerald" GroupController-ref="paletteGroup">
                          <ev.SelectedChanged-eval><![CDATA[{if (paletteEmerald.Selected) {self.PaletteSelected(3);}}]]></ev.SelectedChanged-eval>
                        </RadioButton>
                      </StackItem>
                      <StackItem>
                        <RadioButton ref.Name="paletteSkyblue" Text="SkyBlue (default)" GroupController-ref="paletteGroup" Selected="true">
                          <ev.SelectedChanged-eval><![CDATA[{if (paletteSkyblue.Selected) {self.PaletteSelected(4);}}]]></ev.SelectedChanged-eval>
                        </RadioButton>
                      </StackItem>
                      <StackItem>
                        <RadioButton ref.Name="palettePurple" Text="Purple" GroupController-ref="paletteGroup">
                          <ev.SelectedChanged-eval><![CDATA[{if (palettePurple.Selected) {self.PaletteSelected(5);}}]]></ev.SelectedChanged-eval>
                        </RadioButton>
                      </StackItem>
                    </Stack>
                  </GroupBox>
                </Cell>
              </Table>
            </TabPage>
            <TabPage Alt="X" Text="Exit">
              <Stack Direction="Vertical" AlignmentToParent="left:0 top:0 right:0 bottom:0" Padding="0" MinSizeLimitation="LimitToElementAndChildren">
                <StackItem>
                  <Button Text="self.Hide() (InvokeInMainThread)">
                    <ev.Clicked-eval><![CDATA[{
                      GuiApplication::GetApplication().InvokeInMainThread(self, func():void
                      {
                        self.Hide(); self.invocationCount = self.invocationCount + 1;
                      });
                    }]]></ev.Clicked-eval>
                  </Button>
                </StackItem>
                <StackItem>
                  <Button Text="self.Hide()">
                    <ev.Clicked-eval><![CDATA[{
                      self.Hide(); self.invocationCount = self.invocationCount + 1;
                    }]]></ev.Clicked-eval>
                  </Button>
                </StackItem>
                <StackItem>
                  <Button Text="self.Close() (InvokeInMainThread)">
                    <ev.Clicked-eval><![CDATA[{
                      GuiApplication::GetApplication().InvokeInMainThread(self, func():void
                      {
                        self.Close(); self.invocationCount = self.invocationCount + 1;
                      });
                    }]]></ev.Clicked-eval>
                  </Button>
                </StackItem>
                <StackItem>
                  <Button Text="self.Close()">
                    <ev.Clicked-eval><![CDATA[{
                      self.Close(); self.invocationCount = self.invocationCount + 1;
                    }]]></ev.Clicked-eval>
                  </Button>
                </StackItem>
                <StackItem>
                  <CheckBox ref.Name="checkCancelClose" Text="Cancel Hide/Close requests" Selected="false" />
                </StackItem>
                <StackItem>
                  <Label Text="Hide/Close query WindowClosing; accepted requests stop TUI after WindowReadyToClose." />
                </StackItem>
                <StackItem>
                  <Label Text-format="Invocations completed: $(self.invocationCount); closing queries: $(self.closingCount); ready: $(self.readyToCloseCount)" />
                </StackItem>
                <StackItem>
                  <Button Text="Stop TUI">
                    <ev.Clicked-eval><![CDATA[{GuiApplication::GetTuiApplication().Stop();}]]></ev.Clicked-eval>
                  </Button>
                </StackItem>
                <StackItem>
                  <Button Text="Stop TUI (InvokeInMainThread)">
                    <ev.Clicked-eval><![CDATA[{GuiApplication::GetApplication().InvokeInMainThread(self, func():void {GuiApplication::GetTuiApplication().Stop();});}]]></ev.Clicked-eval>
                  </Button>
                </StackItem>
              </Stack>
            </TabPage>
          </att.Pages>
        </Tab>
      </Window>
    </Instance>
  </Instance>
  <Instance name="TextListTabPageResource" content="File">TextListTabPage.xml</Instance>
  <Instance name="ListViewTabPageResource" content="File">ListViewTabPage.xml</Instance>
