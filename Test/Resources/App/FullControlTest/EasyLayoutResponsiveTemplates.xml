<Folder>
  <Instance name="EasyResponsiveAccountItemTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="demo::EasyResponsiveAccountItemTemplate">
      <ref.Parameter Name="ViewModel" Class="demo::EasyResponsiveAccount"/>
      <TextListItemTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <ResponsiveView ref.Name="responsiveView" Direction="Horizontal" AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Views>
            <ResponsiveFixed>
              <ez:Layout>
                <ez:Left>
                  <Bounds PreferredMinSize="x:32 y:32">
                    <ImageFrame Stretch="false" HorizontalAlignment="Center" VerticalAlignment="Center" Image-bind="ViewModel.Image"/>
                  </Bounds>
                </ez:Left>
                <ez:Fill>
                  <Bounds PreferredMinSize="x:160" MinSizeLimitation="LimitToElement">
                    <SolidLabel Text-bind="ViewModel.Name" Font-bind="self.Font" VerticalAlignment="Center" Color-bind="self.TextColor" Ellipse="true"/>
                  </Bounds>
                </ez:Fill>
              </ez:Layout>
            </ResponsiveFixed>
            <ResponsiveFixed>
              <ez:Layout>
                <Bounds PreferredMinSize="x:32 y:32">
                  <ImageFrame Stretch="false" HorizontalAlignment="Center" VerticalAlignment="Center" Image-bind="ViewModel.Image"/>
                </Bounds>
              </ez:Layout>
            </ResponsiveFixed>
          </att.Views>
        </ResponsiveView>
      </TextListItemTemplate>
    </Instance>
  </Instance>

  <Instance name="EasyResponsiveAccountMenuTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="demo::EasyResponsiveAccountMenuTemplate">
      <ref.Parameter Name="ViewModel" Class="demo::EasyResponsiveAccount"/>
      <ControlTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <MenuItemButton ref.Name="menuButton" Text-bind="ViewModel.Name" Selected-bind="ViewModel.Selected">
          <att.BoundsComposition-set AlignmentToParent="left:0 top:0 right:0 bottom:0"/>
          <att.Image-bind>ViewModel.Selected ? cast (GuiImageData^) self.ResolveResource("res", "ResponsiveImages/Selection", true) : null</att.Image-bind>
        </MenuItemButton>
      </ControlTemplate>
    </Instance>
  </Instance>

  <Instance name="EasyResponsiveMovieTemplateResource">
    <Instance ref.CodeBehind="false" ref.Class="demo::EasyResponsiveMovieTemplate">
      <ref.Parameter Name="ViewModel" Class="demo::EasyResponsiveMovie"/>
      <TextListItemTemplate ref.Name="self" MinSizeLimitation="LimitToElementAndChildren">
        <ResponsiveView ref.Name="responsiveView" Direction="Horizontal" AlignmentToParent="left:0 top:0 right:0 bottom:0">
          <att.Views>
            <ResponsiveFixed>
              <ez:Layout>
                <ez:Column>
                  <ez:Row CellSpan="2">
                    <Bounds PreferredMinSize="x:96 y:96">
                      <ImageFrame Stretch="true" Image-bind="ViewModel.Image"/>
                    </Bounds>
                  </ez:Row>
                </ez:Column>
                <ez:Column CellOption="composeType:Percentage percentage:1">
                  <!-- The two text tracks and their five-pixel gap total 96 pixels. -->
                  <ez:Row CellOption="composeType:Absolute absolute:48">
                    <Bounds PreferredMinSize="x:200" MinSizeLimitation="LimitToElement">
                      <SolidLabel Text-bind="ViewModel.Title" Font-bind="self.Font" Color-bind="self.TextColor" Ellipse="true"/>
                    </Bounds>
                  </ez:Row>
                  <ez:Row CellOption="composeType:Absolute absolute:43">
                    <Bounds MinSizeLimitation="LimitToElement">
                      <SolidLabel Text-bind="'by: ' &amp; ViewModel.Author" Font-bind="self.Font" Color-bind="self.TextColor" Ellipse="true"/>
                    </Bounds>
                  </ez:Row>
                </ez:Column>
              </ez:Layout>
            </ResponsiveFixed>
            <ResponsiveFixed>
              <ez:Layout>
                <Bounds PreferredMinSize="x:100" MinSizeLimitation="LimitToElement">
                  <SolidLabel Text-bind="ViewModel.Title" Font-bind="self.Font" Color-bind="self.TextColor" Ellipse="true"/>
                </Bounds>
              </ez:Layout>
            </ResponsiveFixed>
          </att.Views>
        </ResponsiveView>
      </TextListItemTemplate>
    </Instance>
  </Instance>
</Folder>
