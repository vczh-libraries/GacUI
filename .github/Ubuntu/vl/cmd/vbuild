#!/bin/bash
set -e

function Help {
    echo "Usage:"
    echo "--clean"
    echo "    Clean generated files."
    echo "-b, --build"
    echo "    Incrementally build the current folder."
    echo "-f, -fb, --full-build"
    echo "    Rebuild the current folder."
    echo "-o, --optimize"
    echo "    Use -O2 for a native build (default: -O0)."
    echo "    May precede or follow the build command; alone means -b -o."
    echo "-c, --build-coverage"
    echo "    Rebuild the current folder with coverage."
    echo "-fc, --full-build-coverage"
    echo "    Rebuild the current folder with coverage."
    echo "--build-gcc"
    echo "    Incrementally build the current folder using G++."
    echo "--full-build-gcc"
    echo "    Rebuild the current folder using G++."
    echo "-bw, --build-wasm"
    echo "    Incrementally build the current folder using em++ with -O3."
    echo "    Requires \"WASM=YES\" in ./vbuild."
    echo "-fbw, --full-build-wasm"
    echo "    Rebuild the current folder using em++ with -O3."
    echo "    Requires \"WASM=YES\" in ./vbuild."
    echo "-g, --generate"
    echo "    Generate coverage data."
    echo "-r, --read"
    echo "    Read coverage data."
}

function Check {
    if ! [ -f vmake ] || ! [ -f makefile ]; then
        echo "Cannot find ./vmake or ./makefile . Run vmake --make first."
        exit 1
    fi
}

function Clean {
    Check
    make clean
}

function CheckWasm {
    if ! [ -f ./vbuild ] || ! grep -Fq '"WASM=YES"' ./vbuild; then
        echo "WebAssembly is not enabled for this project. Requires \"WASM=YES\" in ./vbuild." >&2
        exit 1
    fi
}

function Build {
    Check
    # Invalidate configuration before make caches any object timestamps.
    make cpp-prepare "$@"
    make "$@"
}

function FullBuild {
    Check
    make clean "$@"
    Build "$@"
}

function Generate {
    Check
    lcov --directory ./Obj/ --base-directory . --gcov-tool ${VCPROOT}/vl/llvm-gcov.sh --capture -o ./Coverage/cov.info
    genhtml ./Coverage/cov.info -o ./Coverage/HTML/
}

function Read {
    Check
    firefox `pwd`/Coverage/HTML/index.html
    #sensible-browser ./Coverage/HTML/index.html 
}

VBUILD_MODE=""
VBUILD_OPTIMIZE=NO
for VBUILD_ARG in "$@"; do
    case "${VBUILD_ARG}" in
        -o|--optimize)
        if [ "${VBUILD_OPTIMIZE}" == YES ]; then
            echo "Optimization was specified more than once." >&2
            exit 1
        fi
        VBUILD_OPTIMIZE=YES
        ;;

        --help|--clean|-b|--build|-f|-fb|--full-build|-c|--build-coverage|-fc|--full-build-coverage|--build-gcc|--full-build-gcc|-bw|--build-wasm|-fbw|--full-build-wasm|-g|--generate|-r|--read)
        if [ -n "${VBUILD_MODE}" ]; then
            echo "Specify only one vbuild command." >&2
            exit 1
        fi
        VBUILD_MODE="${VBUILD_ARG}"
        ;;

        *)
        echo "Unknown argument: ${VBUILD_ARG}. Use --help for more information." >&2
        exit 1
        ;;
    esac
done

VBUILD_MODE="${VBUILD_MODE:--b}"
VBUILD_OPTIMIZATION=-O0
if [ "${VBUILD_OPTIMIZE}" == YES ]; then
    case "${VBUILD_MODE}" in
        -b|--build|-f|-fb|--full-build|-c|--build-coverage|-fc|--full-build-coverage|--build-gcc|--full-build-gcc)
        VBUILD_OPTIMIZATION=-O2
        ;;
        *)
        echo "-o/--optimize is supported only for native builds." >&2
        exit 1
        ;;
    esac
fi

case "${VBUILD_MODE}" in
    --help)
    Help
    ;;

    --clean)
    Clean
    ;;

    -b|--build)
    Build CPP_COMPILER=CLANG COVERAGE=NO CPP_OPTIMIZATION="${VBUILD_OPTIMIZATION}"
    ;;

    -f|-fb|--full-build)
    FullBuild CPP_COMPILER=CLANG COVERAGE=NO CPP_OPTIMIZATION="${VBUILD_OPTIMIZATION}"
    ;;

    -c|--build-coverage)
    Build CPP_COMPILER=CLANG COVERAGE=YES CPP_OPTIMIZATION="${VBUILD_OPTIMIZATION}"
    ;;

    -fc|--full-build-coverage)
    FullBuild CPP_COMPILER=CLANG COVERAGE=YES CPP_OPTIMIZATION="${VBUILD_OPTIMIZATION}"
    ;;

    --build-gcc)
    Build CPP_COMPILER=GCC COVERAGE=NO CPP_OPTIMIZATION="${VBUILD_OPTIMIZATION}"
    ;;

    --full-build-gcc)
    FullBuild CPP_COMPILER=GCC COVERAGE=NO CPP_OPTIMIZATION="${VBUILD_OPTIMIZATION}"
    ;;

    -bw|--build-wasm)
    CheckWasm
    Build CPP_COMPILER=EMPP COVERAGE=NO CPP_OPTIMIZATION=-O3
    ;;

    -fbw|--full-build-wasm)
    CheckWasm
    FullBuild CPP_COMPILER=EMPP COVERAGE=NO CPP_OPTIMIZATION=-O3
    ;;

    -g|--generate)
    Generate
    ;;

    -r|--read)
    Read
    ;;

    *)
    echo "Use --help for more information."
    exit 1
    ;;
esac
